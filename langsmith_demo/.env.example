# Copy to langsmith_demo/.env and fill in. Never commit .env.
#
# Same model-under-test + cloud-judge split as the deep_eval demo, plus a
# LangSmith key (LangSmith uploads datasets/experiments to its server). Falls
# back to the parent suite's VLLM_* / ANTHROPIC_API_KEY if these are unset.

# --- LangSmith ---------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true

# --- Model under test (OpenAI-compatible: vLLM, Fidaro gateway, Ollama, ...) --
MUT_BASE_URL=http://127.0.0.1:8082/v1
MUT_API_KEY=dummy
MUT_MODEL_ID=Qwen/Qwen3-Next-80B-A3B-Thinking-FP8
MUT_STRIP_THINKING=1

# --- Judge (LLM-as-judge for the rubric experiment) --------------------------
JUDGE_PROVIDER=anthropic
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-sonnet-4-6

# openai-compatible judge alternative (when JUDGE_PROVIDER=openai):
# JUDGE_BASE_URL=https://api.openai.com/v1
# JUDGE_API_KEY=
# JUDGE_MODEL=gpt-4o
