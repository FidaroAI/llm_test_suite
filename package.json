{
  "name": "llm-test-suite",
  "version": "0.1.0",
  "private": true,
  "description": "Regression test suite for self-hosted LLMs, powered by promptfoo.",
  "scripts": {
    "test:all": "bash scripts_test/fidaro.sh",
    "view": "promptfoo view --yes",
    "dataset": "pnpm dataset:researchrubrics && pnpm dataset:agentharm && pnpm dataset:multifaceted",
    "dataset:researchrubrics": "node scripts_repo/download_researchrubrics.mjs",
    "dataset:agentharm": "node scripts_repo/download_agentharm.mjs",
    "dataset:multifaceted": "node scripts_repo/download_multifaceted.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1044.0",
    "promptfoo": "^0.121.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}