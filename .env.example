# Copy to .env and fill in. Never commit .env.
#
# Ollama on localhost — usually requires no key, but if you've put it behind
# a proxy you can override the base URL here.
# OLLAMA_HOST=http://localhost:11434

# vLLM (or any OpenAI-compatible) host on your LAN.
VLLM_BASE_URL=http://lab.lan:8000/v1
VLLM_API_KEY=changeme
# Model id served by your vLLM endpoint (see GET /v1/models).
VLLM_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
# Port the in-repo launcher should bind. Used by ./scripts/start_vllm.sh.
VLLM_PORT=8000
# Reasoning parser to enable for thinking models (e.g. deepseek_r1, qwen3).
# Leave unset for non-reasoning models.
# VLLM_REASONING_PARSER=deepseek_r1
# Optional vLLM tuning flags consumed by the launcher.
# VLLM_DTYPE=bfloat16
# VLLM_GPU_MEMORY_UTILIZATION=0.9

# Optional sidecar admin endpoint used by hooks/before_each.py to hot-swap
# vLLM sampling defaults at test time. Leave unset if you don't run one.
# VLLM_ADMIN=http://lab.lan:8001

# AWS Bedrock via Converse API. Auth uses the standard AWS credential chain
# (~/.aws/credentials, AWS_PROFILE, IAM role, AWS_ACCESS_KEY_ID/SECRET, etc.) —
# no bearer token. Set up creds with `aws configure` or `export AWS_PROFILE=...`.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Rubric grader (llm-rubric judge) runs on AWS Bedrock — see
# defaultTest.options.provider in promptfooconfig.yaml (Claude 3.5 Haiku, pinned).
# It needs the same AWS credentials as above. For local runs either set
# AWS_PROFILE or the two keys below; in CI, set them as GitHub Actions secrets.
# The grader model requires Bedrock model access enabled in AWS_REGION.
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
