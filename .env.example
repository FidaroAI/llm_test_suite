# Copy to .env and fill in. Never commit .env.

# Legacy stuff used when experimenting. May go away. This was used when
# Ollama was never used. Probably can be deleted.
# Ollama on localhost — usually requires no key, but if you've put it behind
# a proxy you can override the base URL here.
# OLLAMA_HOST=http://localhost:11434

# Legacy stuff used when experimenting. May go away. This was used when
# experimenting with tests that run directly against a vllm instance.
# vLLM (or any OpenAI-compatible) host on your LAN.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=changeme
VLLM_MODEL_ID=local-dev-model

# Legacy stuff used when experimenting. May go away.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Bedrock token for model evaluation. This is used in rubric tests to evaluate the output
# of models.
AWS_BEARER_TOKEN_BEDROCK=

# Convenience env vars for running the plaintext gateway against dev and prod. These are
# used by the run_plaintext_gateway_wrapper.sh script. You can get the phala URLs from the
# phala console. WARNING: URLs must include the path /v1 at the end.
PHALA_PROD_VLLM_URL=
PHALA_DEV_VLLM_URL=
BRAVE_API_KEY=
