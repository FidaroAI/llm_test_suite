{
  "name": "fidaro-prod",
  "model": "openai/auto",
  "base_url": "${FIDARO_PROD_BASE_URL}",
  "api_key_env": "FIDARO_API_KEY",
  "params": {
    "temperature": 0.7,
    "max_tokens": 100000,
    "extra_body": {
      "stream": false
    }
  },
  "extra": {
    "backend_version": "phala-prod"
  },
  "cache_key_fields": [
    "model",
    "temperature",
    "backend_version"
  ]
}