{
  "name": "fidaro-dev",
  "model": "openai/auto",
  "base_url": "${FIDARO_DEV_BASE_URL}",
  "api_key_env": "FIDARO_API_KEY",
  "stream": true,
  "params": {
    "temperature": 0.7,
    "max_tokens": 5000
  },
  "extra": {
    "backend_version": "phala-dev"
  },
  "cache_key_fields": [
    "model",
    "temperature",
    "backend_version"
  ]
}
