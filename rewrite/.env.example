# Copy to .env and fill in. Only the keys for providers/judges you actually use
# are required. The core (cache, store, grading replay, reports) needs none.

# --- Judge / grader (LLM-graded assertions, g-eval, pick-best) ---
# litellm reads provider creds from standard env vars. For AWS Bedrock:
AWS_REGION=us-east-1
# Either standard AWS creds (AWS_ACCESS_KEY_ID/SECRET) or a Bedrock bearer token:
AWS_BEARER_TOKEN_BEDROCK=

# --- Example: OpenAI-compatible providers (Fidaro plaintext gateway, vLLM, etc.) ---
# These are referenced by provider config files (see configs/), not hardcoded.
# A provider config supplies base_url + which env var holds its key.
FIDARO_PROD_BASE_URL=http://127.0.0.1:8082/v1
FIDARO_DEV_BASE_URL=http://127.0.0.1:8084/v1
FIDARO_API_KEY=changeme

# --- Example: a direct competitor API ---
VENICE_INFERENCE_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
