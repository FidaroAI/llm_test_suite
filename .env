# Copy to .env and fill in. Never commit .env.
#
# Ollama on localhost — usually requires no key, but if you've put it behind
# a proxy you can override the base URL here.
# OLLAMA_HOST=http://localhost:11434

# vLLM (or any OpenAI-compatible) host on your LAN.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=changeme
VLLM_MODEL_ID=local-dev-model

# Optional sidecar admin endpoint used by hooks/before_each.py to hot-swap
# vLLM sampling defaults at test time. Leave unset if you don't run one.
# VLLM_ADMIN=http://lab.lan:8001

# Cloud judge (optional, only needed once you wire up llm-rubric):
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# AWS Bedrock OpenAI-compatible endpoint (Bearer-token auth).
# BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
# BEDROCK_API_KEY=bedrock-api-key-
BEDROCK_MODEL_ID=qwen.qwen3-next-80b-a3b
AWS_REGION=us-east-1
