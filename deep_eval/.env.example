# Copy to deep_eval/.env and fill in. Never commit .env.
#
# Mirrors the parent promptfoo suite's split: a self-hosted / OpenAI-compatible
# MODEL UNDER TEST, plus a (cloud) JUDGE used only for the LLM-as-judge rubric.
# If these are unset, the demo falls back to the parent suite's VLLM_* / ANTHROPIC_API_KEY
# vars, so an existing top-level .env mostly "just works".

# --- Model under test (the LLM whose answers we score) -----------------------
# Any OpenAI-compatible endpoint: vLLM, the Fidaro plaintext gateway, Ollama, etc.
MUT_BASE_URL=http://127.0.0.1:8082/v1
MUT_API_KEY=dummy
MUT_MODEL_ID=Qwen/Qwen3-Next-80B-A3B-Thinking-FP8
# Strip a leading <think>...</think> reasoning block before scoring (like the
# parent suite's strip_before_triple_newline transform). 1=on, 0=off.
MUT_STRIP_THINKING=1

# --- Judge (LLM-as-judge for the GEval rubric test) --------------------------
# JUDGE_PROVIDER: "anthropic" (default), "bedrock" (native AWS Bedrock), or
# "openai" (any OpenAI-compatible URL).
JUDGE_PROVIDER=anthropic

# anthropic judge:
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-sonnet-4-6

# bedrock judge (used when JUDGE_PROVIDER=bedrock) — the SAME Claude models as the
# parent promptfoo suite (native Bedrock, not the /openai/v1 shim, which only
# serves gpt-oss). Auth is a Bedrock API key (bearer token) OR the standard AWS
# SigV4 chain (AWS_ACCESS_KEY_ID/SECRET or AWS_PROFILE). Defaults to Haiku 4.5.
# JUDGE_PROVIDER=bedrock
# AWS_BEARER_TOKEN_BEDROCK=        # or rely on the AWS credential chain instead
# JUDGE_REGION=us-east-1           # falls back to AWS_REGION, then us-east-1
# JUDGE_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# openai-compatible judge (used when JUDGE_PROVIDER=openai) — e.g. OpenAI itself.
# NOTE: Bedrock's /openai/v1 endpoint only serves gpt-oss models, NOT Claude —
# use JUDGE_PROVIDER=bedrock above to judge with a Bedrock-hosted Claude.
# JUDGE_BASE_URL=https://api.openai.com/v1
# JUDGE_API_KEY=
# JUDGE_MODEL=gpt-4o
